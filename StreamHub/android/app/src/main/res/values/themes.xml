<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StreamHub" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/background_dark</item>
        <item name="colorPrimaryVariant">@color/bottom_nav_bg</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorSecondary">@color/gray</item>
        <item name="android:navigationBarColor">@color/bottom_nav_bg</item>
        <item name="android:statusBarColor">@color/background_dark</item>
    </style>

    <style name="Theme.StreamHub.Fullscreen" parent="Theme.StreamHub">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
