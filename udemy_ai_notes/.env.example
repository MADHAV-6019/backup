# ==============================================
# Udemy AI Notes — Environment Variables
# ==============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your .env file to version control!
# ==============================================

# --- LLM Provider API Keys ---
# Set the key for your chosen provider (configure in config.yaml)
OPENAI_API_KEY=sk-your-openai-key-here
# Optional: API keys for alternative LLM providers
# GOOGLE_API_KEY=your_google_gemini_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key
# GROQ_API_KEY=your_groq_api_key-here

# --- Optional ---
# Override the default output directory
# NOTES_AI_OUTPUT_DIR=./output

# Override the default config file path
# NOTES_AI_CONFIG=./config.yaml
